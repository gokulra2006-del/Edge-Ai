# Sentinel-AI Edge Environment Configuration Example
# Copy this file to .env and configure secrets for your deployment.

# Dashboard Session Secret Key (Used for HMAC session tokens and CSRF protection)
SENTINEL_SESSION_SECRET=generate-a-secure-random-secret-key-32-chars-min

# Environment Mode: development / production / staging
SENTINEL_ENV=production

# Initial Setup / Bootstrap Admin (Optional: used only if user database is empty)
# SENTINEL_ADMIN_USERNAME=commander
# SENTINEL_ADMIN_PASSWORD=change-me-to-a-strong-password

# Firebase Realtime Database Sync (Optional Cloud Mirror)
# FIREBASE_DB_URL=https://your-project-default-rtdb.firebaseio.com/
# FIREBASE_AUTH_KEY=your-firebase-database-secret-or-service-account-token

# Hardware Node Identification
SENTINEL_NODE_ID=NODE_B_INTERSECTION
SENTINEL_ZONE_NAME=ZONE_B_INTERSECTION

# Session Timeouts (seconds)
SENTINEL_SESSION_IDLE_TIMEOUT=1800
SENTINEL_SESSION_ABSOLUTE_TIMEOUT=28800

# Rate Limiting & Lockout
SENTINEL_LOGIN_MAX_ATTEMPTS=5
SENTINEL_LOGIN_LOCKOUT_SECONDS=900
